load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# Core ninja library containing all the implementation
cc_library(
    name = "ninja_lib",
    srcs = [
        "build.cc",
        "build_log.cc", 
        "clean.cc",
        "clparser.cc",
        "debug_flags.cc",
        "depfile_parser.cc",
        "deps_log.cc",
        "disk_interface.cc",
        "dyndep.cc",
        "dyndep_parser.cc",
        "edit_distance.cc",
        "elide_middle.cc",
        "eval_env.cc",
        "graph.cc",
        "graphviz.cc",
        "json.cc",
        "jobserver.cc",
        "lexer.cc",
        "line_printer.cc",
        "manifest_parser.cc",
        "metrics.cc",
        "missing_deps.cc",
        "parser.cc",
        "real_command_runner.cc",
        "state.cc",
        "status_printer.cc",
        "string_piece_util.cc",
        "util.cc",
        "version.cc",
    ] + select({
        "@platforms//os:windows": [
            "getopt.c",
            "includes_normalize-win32.cc",
            "jobserver-win32.cc",
            "minidump-win32.cc",
            "msvc_helper-win32.cc",
            "subprocess-win32.cc",
        ],
        "//conditions:default": [
            "jobserver-posix.cc",
            "subprocess-posix.cc",
        ],
    }),
    hdrs = [
        "build.h",
        "build_log.h",
        "browse.h",
        "clean.h",
        "clparser.h",
        "command_collector.h",
        "debug_flags.h",
        "depfile_parser.h",
        "deps_log.h",
        "disk_interface.h",
        "dyndep.h",
        "dyndep_parser.h",
        "edit_distance.h",
        "elide_middle.h",
        "eval_env.h",
        "exit_status.h",
        "explanations.h",
        "graph.h",
        "graphviz.h",
        "hash_map.h",
        "includes_normalize.h",
        "jobserver.h",
        "json.h",
        "lexer.h",
        "line_printer.h",
        "load_status.h",
        "manifest_parser.h",
        "metrics.h",
        "missing_deps.h",
        "msvc_helper.h",
        "parser.h",
        "state.h",
        "status.h",
        "status_printer.h",
        "string_piece.h",
        "string_piece_util.h",
        "subprocess.h",
        "test.h",
        "timestamp.h",
        "util.h",
        "version.h",
        "third_party/emhash/hash_table8.hpp",
        "third_party/rapidhash/rapidhash.h",
    ] + select({
        "@platforms//os:windows": [
            "getopt.h",
            "win32port.h",
        ],
        "//conditions:default": [],
    }),
    includes = [".", "third_party"],
    copts = select({
        "@platforms//os:windows": [
            "/W4",
            "/wd4100",
            "/wd4267", 
            "/wd4706",
            "/wd4702",
            "/wd4244",
            "/GR-",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-Wall",
            "-Wextra",
            "-Wno-deprecated",
            "-Wno-unused-parameter",
        ],
    }),
    defines = select({
        "@platforms//os:windows": [
            "_CRT_SECURE_NO_WARNINGS",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

# Main ninja binary
cc_binary(
    name = "ninja",
    srcs = ["ninja.cc"],
    deps = [":ninja_lib"],
    visibility = ["//visibility:public"],
)

# Test framework
cc_library(
    name = "test_lib",
    srcs = ["test.cc"],
    hdrs = ["test.h"],
    deps = [
        ":ninja_lib",
        "@googletest//:gtest",
    ],
    visibility = ["//visibility:public"],
)

