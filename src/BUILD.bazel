# First Bazel package: builds the independent elide_middle library.
cc_library(
    name = "elide_middle",
    srcs = ["elide_middle.cc"],
    hdrs = ["elide_middle.h"],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# ---------------------------------------------------------------------------
# Debug-flags header (header-only, used by graph and others).
cc_library(
    name = "debug_flags_hdr",
    hdrs = ["debug_flags.h"],
    visibility = ["//visibility:public"],
)

# Load-status enum (header-only, shared across modules).
cc_library(
    name = "load_status",
    hdrs = ["load_status.h"],
    visibility = ["//visibility:public"],
)

# Core dependency-graph implementation.
cc_library(
    name = "graph",
    srcs = ["graph.cc"],
    hdrs = [
        "graph.h",
        # headers directly included by graph.cc / graph.h
        "build_log.h",
        "depfile_parser.h",
        "deps_log.h",
        "disk_interface.h",
        "manifest_parser.h",
        "state.h",
        "dyndep.h",
        "eval_env.h",
        "explanations.h",
        "jobserver.h",
        "timestamp.h",
    ],
    deps = [
        ":util",
        ":metrics",
        ":hash_map",
        ":load_status",
        ":debug_flags_hdr",
    ],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# Debug-flags implementation (depends on graph).
cc_library(
    name = "debug_flags",
    srcs = ["debug_flags.cc"],
    deps = [
        ":graph",
        ":util",
        ":debug_flags_hdr",
    ],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# JSON parsing helpers.
cc_library(
    name = "json",
    srcs = ["json.cc"],
    hdrs = ["json.h"],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# Header-only StringPiece slice type.
cc_library(
    name = "string_piece",
    hdrs = ["string_piece.h"],
    visibility = ["//visibility:public"],
)

# Independent edit_distance library.
cc_library(
    name = "edit_distance",
    srcs = ["edit_distance.cc"],
    hdrs = ["edit_distance.h"],
    deps = [":string_piece"],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# Third-party rapidhash header-only library.
cc_library(
    name = "rapidhash",
    hdrs = glob(["third_party/rapidhash/**/*.h"]),
    includes = ["third_party/rapidhash"],
    visibility = ["//visibility:public"],
)

# Third-party emhash header-only library.
cc_library(
    name = "emhash",
    hdrs = glob(["third_party/emhash/**/*.hpp"]),
    includes = ["third_party/emhash"],
    visibility = ["//visibility:public"],
)

# Hash-map utilities that wrap emhash with StringPiece hashing.
cc_library(
    name = "hash_map",
    hdrs = ["hash_map.h"],
    deps = [
        ":string_piece",
        ":rapidhash",
        ":emhash",
    ],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# String utilities built on top of StringPiece.
cc_library(
    name = "string_piece_util",
    srcs = ["string_piece_util.cc"],
    hdrs = ["string_piece_util.h"],
    deps = [":string_piece"],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# Generic utility helpers used across Ninja.
cc_library(
    name = "util",
    srcs = ["util.cc"],
    hdrs = ["util.h"],
    deps = [
        ":edit_distance",
        ":string_piece_util",
    ],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)

# Build-time metrics helpers.
cc_library(
    name = "metrics",
    srcs = ["metrics.cc"],
    hdrs = ["metrics.h"],
    deps = [":util"],
    visibility = ["//visibility:public"],
    copts = ["-std=c++11"],
)
