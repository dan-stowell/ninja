        "src/third_party/rapidhash/rapidhash.h",
        "src/browse.h",
    ],
    copts = select({
        "@platforms//os:windows": [
            "/W4",
            "/wd4100",
            "/wd4267",
            "/wd4706",
            "/wd4702",
            "/wd4244",
            "/GR-",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-std=c++11",
            "-Wno-deprecated",
        ],
    }),
    defines = select({
        "@platforms//os:windows": [
            "_CRT_SECURE_NO_WARNINGS",
