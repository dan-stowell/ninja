        "src/line_printer.h",
        "src/manifest_parser.h",
        "src/metrics.h",
        "src/missing_deps.h",
        "src/parser.h",
        "src/state.h",
        "src/status_printer.h",
        "src/string_piece_util.h",
        "src/util.h",
        "src/version.h",
        "src/command_collector.h",
