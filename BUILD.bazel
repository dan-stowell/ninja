            "src/jobserver-posix.cc",
            "src/subprocess-posix.cc",
        ],
    }),
    hdrs = [
        "src/build_log.h",
        "src/build.h",
        "src/clean.h",
        "src/clparser.h",
        "src/dyndep.h",
        "src/dyndep_parser.h",
        "src/debug_flags.h",
        "src/deps_log.h",
        "src/disk_interface.h",
        "src/edit_distance.h",
        "src/elide_middle.h",
        "src/eval_env.h",
        "src/graph.h",
        "src/graphviz.h",
