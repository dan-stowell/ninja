    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": [],
    }),
    deps = [":libninja-re2c"],
    visibility = ["//visibility:private"],
)

# Re2c generated files library
cc_library(
    name = "libninja-re2c",
    srcs = [
        "src/depfile_parser.cc",
        "src/lexer.cc",
    ],
    hdrs = [
        "src/depfile_parser.h",
        "src/lexer.h",
        "src/string_piece.h",
        "src/eval_env.h",
    ],
    copts = select({
        "@platforms//os:windows": [
            "/W4",
            "/wd4100",
            "/wd4267",
            "/wd4706",
            "/wd4702",
            "/wd4244",
            "/GR-",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-std=c++11",
            "-Wno-deprecated",
        ],
    }),
    visibility = ["//visibility:private"],
)

# Main ninja binary
cc_binary(
    name = "ninja",
    srcs = ["src/ninja.cc"],
    deps = [
        ":libninja",
        ":libninja-re2c",
    ],
    copts = select({
        "@platforms//os:windows": [
            "/W4",
            "/wd4100",
            "/wd4267",
            "/wd4706",
            "/wd4702",
            "/wd4244",
            "/GR-",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-std=c++11",
            "-Wno-deprecated",
        ],
    }),
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)